# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only — never expose to the browser. Used by contact form + admin plan activation.
SUPABASE_SERVICE_ROLE_KEY=

# Gemini (server only)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Long random string (16+ chars). Authorizes POST /api/admin/activate after you verify a payment.
ADMIN_SECRET=
